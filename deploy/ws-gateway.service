[Unit]
Description=CatsCo Artifact Gateway P0 WSS transport adapter
After=network.target catsco-artifact-gateway-p0.service

[Service]
User=cag_ingress
Group=cag_ingress
WorkingDirectory=/opt/catsco-artifact-gateway
ExecStart=/usr/local/bin/node /opt/catsco-artifact-gateway/src/ws-gateway.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=128M
TasksMax=32
# Two descriptors per tunnel (the websocket plus the loopback sshd socket). The
# default of 1024 caps the process near 500 tunnels, which is below where the
# connection limit is meant to sit, so the allowance is raised to keep the socket
# budget from becoming the limit that is hit first.
LimitNOFILE=2048
CPUQuota=25%

[Install]
WantedBy=multi-user.target
